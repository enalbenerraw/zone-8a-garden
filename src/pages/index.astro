---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const categories = ['Plan', 'Plant', 'Protect'] as const;
const blurbs: Record<(typeof categories)[number], string> = {
  Plan: 'Decide what goes where, and when.',
  Plant: 'Put crops in the ground and hand the bed off cleanly.',
  Protect: 'Keep the brassicas through the pest window and into winter.',
};
---

<Base title="Zone 8a Garden: Fall and Winter Growing Guide">
  <h1>A Zone 8a fall garden that works all winter</h1>
  <p>
    One raised bed, three crops a year: spring spinach, summer nitrogen-fixing
    beans, then fall and winter brassicas. These guides document the full
    rotation, from the planting calendar to the pest plan, for USDA Zone 8a.
  </p>
  <p>
    New here? Start with the <a href={`${base}/launch/`}>launch summary</a> for the
    whole project in one read, or follow the <a href={`${base}/journal/`}>garden journal</a>
    for dated photos through the seasons.
  </p>

  <h2 id="guides">Guides</h2>
  {categories.map((cat) => (
    <section>
      <h3>{cat}</h3>
      <p>{blurbs[cat]}</p>
      <ul>
        {guides
          .filter((g) => g.data.category === cat)
          .map((g) => (
            <li>
              <a href={`${base}/guides/${g.id}/`}>{g.data.title}</a>
              {': '}
              {g.data.description}
            </li>
          ))}
      </ul>
    </section>
  ))}
</Base>
