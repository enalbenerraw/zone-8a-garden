---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import gardenOverview from '../content/journal/_photos/2026-05-08-garden-overview.jpeg';
import tomatoes from '../content/journal/_photos/2026-06-20-tomatoes.png';

// Home page photo rotation. Each visit shows one at random; the first is
// shown when JavaScript is off. To add a photo, put it in
// src/content/journal/_photos/, import it above, and add a line here.
// `position` is the vertical crop focus for the 420px-tall banner.
const heroes = [
  { src: gardenOverview, alt: 'The whole Zone 8a garden in May: netted hoops over a raised bed, a hoop house, and rows of onions and potatoes in pine-straw mulch behind a black iron fence', position: '50%' },
  { src: tomatoes, alt: 'Tomatoes ripening in the Zone 8a raised bed in early summer', position: '52%' },
];

const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const categories = ['Plan', 'Plant', 'Protect'] as const;
const blurbs: Record<(typeof categories)[number], string> = {
  Plan: 'Decide what goes where, and when.',
  Plant: 'Put crops in the ground and hand the bed off cleanly.',
  Protect: 'Keep crops healthy from the spring pests through the winter brassica window.',
};
---

<Base title="Zone 8a Garden: A Year-Round Growing Guide">
  <h1>A Zone 8a garden that works all year</h1>
  <figure class="home-hero">
    {/* Every photo sits in a <template>, which browsers never fetch from, so
        only the one the script picks is downloaded. <noscript> shows the
        first photo when JavaScript is off. */}
    {heroes.map((h) => (
      <template>
        <Image src={h.src} alt={h.alt} widths={[480, 760, 960]} sizes="(max-width: 760px) 100vw, 760px" style={`object-position: center ${h.position}`} />
      </template>
    ))}
    <noscript>
      <Image src={heroes[0].src} alt={heroes[0].alt} widths={[480, 760, 960]} sizes="(max-width: 760px) 100vw, 760px" style={`object-position: center ${heroes[0].position}`} />
    </noscript>
  </figure>
  <script is:inline>
    // Runs before first paint, so the banner never shows an empty frame.
    (() => {
      const fig = document.querySelector('.home-hero');
      const all = fig.querySelectorAll('template');
      const pick = all[Math.floor(Math.random() * all.length)];
      fig.append(pick.content.cloneNode(true));
    })();
  </script>
  <p>
    Multiple raised beds, each run as a relay: spring greens and peas, summer
    nitrogen-fixing beans and warm-season crops, then the fall and winter
    brassicas that mature into the cold. These guides document the full
    year-round rotation, from the planting calendar to the pest plan, for USDA
    Zone 8a.
  </p>
  <p>
    Garden somewhere else? The <a href={`${base}/kit/`}>Zone-Smart Garden Prompt
    Kit</a> rebuilds this whole calendar for your own USDA zone. Or start with
    the <a href={`${base}/launch/`}>launch summary</a> for the project in one read, or
    the <a href={`${base}/journal/`}>garden journal</a> for dated photos through the
    seasons.
  </p>

  <h2 id="guides">Guides</h2>
  {categories.map((cat) => (
    <section>
      <h3>{cat}</h3>
      <p>{blurbs[cat]}</p>
      <ul>
        {guides
          .filter((g) => g.data.category === cat)
          .map((g) => (
            <li>
              <a href={`${base}/guides/${g.id}/`}>{g.data.title}</a>
              {': '}
              {g.data.description}
            </li>
          ))}
      </ul>
    </section>
  ))}

  <style>
    .home-hero {
      margin: 1.5rem 0 2rem;
    }
    .home-hero :global(img) {
      width: 100%;
      height: 420px;
      object-fit: cover;
      display: block;
      border: 1px solid var(--line);
      border-radius: 6px;
    }
  </style>
</Base>
