---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const entries = await getCollection('journal');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const dateLabel = entry.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<Base title={entry.data.title} description={`${entry.data.phase}, ${dateLabel}.`}>
  <p><a href={`${base}/journal/`}>&larr; Bed journal</a></p>
  <h1>{entry.data.title}</h1>
  <p><em>{entry.data.phase} &middot; {dateLabel}</em></p>

  <Content />

  <div class="gallery">
    {entry.data.photos.map((photo) => (
      <figure>
        <Image src={photo.src} alt={photo.alt} widths={[480, 760, 1140]} sizes="(max-width: 760px) 100vw, 760px" />
        {photo.caption && <figcaption>{photo.caption}</figcaption>}
      </figure>
    ))}
  </div>
</Base>

<style>
  .gallery {
    margin-top: 2rem;
    display: grid;
    gap: 1.5rem;
  }
  figure {
    margin: 0;
  }
  figure :global(img) {
    width: 100%;
    height: auto;
    border-radius: 4px;
    border: 1px solid var(--line);
  }
  figcaption {
    margin-top: 0.4rem;
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.85rem;
    color: #6b6f63;
  }
</style>
