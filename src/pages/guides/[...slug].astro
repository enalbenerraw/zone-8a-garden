---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PlantingTimeline from '../../components/PlantingTimeline.astro';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title={guide.data.title} description={guide.data.description}>
  <p><a href={`${base}/#guides`}>&larr; All guides</a></p>
  <h1>{guide.data.title}</h1>
  <p><em>Updated {guide.data.updated}</em></p>
  {guide.data.timeline && <PlantingTimeline />}
  <Content />
</Base>
