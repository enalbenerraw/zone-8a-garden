---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PlantingTimeline from '../../components/PlantingTimeline.astro';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title={guide.data.title} description={guide.data.description}>
  <p><a href={`${base}/#guides`}>&larr; All guides</a></p>
  <h1>{guide.data.title}</h1>
  <p><em>Updated {guide.data.updated}</em></p>
  {guide.data.hero && (
    <figure class="hero">
      <Image src={guide.data.hero.src} alt={guide.data.hero.alt} widths={[480, 760, 1140]} sizes="(max-width: 760px) 100vw, 760px" />
      {guide.data.hero.caption && <figcaption>{guide.data.hero.caption}</figcaption>}
    </figure>
  )}
  {guide.data.timeline && <PlantingTimeline />}
  <Content />
</Base>

<style>
  .hero {
    margin: 1.5rem 0 0;
  }
  .hero :global(img) {
    width: 100%;
    height: auto;
    border-radius: 4px;
    border: 1px solid var(--line);
  }
  .hero figcaption {
    margin-top: 0.4rem;
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.85rem;
    color: #6b6f63;
  }
</style>
