---
interface Props {
  title: string;
  description?: string;
  image?: string;
}
const { title, description = 'A practical year-round gardening guide for USDA Zone 8a.', image = '/og-zone8a.png' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = Astro.site ?? new URL('https://zone8a.com');
const pageUrl = new URL(Astro.url.pathname, siteUrl);
const ogImageUrl = new URL(`${base}${image}`, siteUrl);
const CONTACT_FORM_URL = 'https://forms.gle/3kBb9hAvTVyQC96N6';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Zone 8a Garden" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image:alt" content="Zone 8a Garden: one raised bed run all year, spring spinach to summer beans to fall and winter brassicas." />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>
  <body>
    <header>
      <nav>
        <a class="brand" href={`${base}/`}>Zone 8a Garden</a>
        <a href={`${base}/#guides`}>Guides</a>
        <a href={`${base}/journal/`}>Journal</a>
        <a href={`${base}/changelog/`}>Changelog</a>
        <a href={`${base}/kit/`}>Get the Kit</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>Gardening in USDA Zone 8a. Adjust dates to your own frost calendar.</p>
      <p class="cta">
        Curious about the code behind this site?{' '}
        <a href={CONTACT_FORM_URL} target="_blank" rel="noopener noreferrer">Get in touch &rarr;</a>
      </p>
      <p>&copy; <a href="https://blanewarrene.com">Blane Warrene</a></p>
    </footer>
    <style is:global>
      :root {
        --ink: #20281f;
        --leaf: #3f6b3a;
        --leaf-dark: #2c4d28;
        --paper: #f7f6f0;
        --line: #d9d6c6;
        --max: 760px;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        font-family: ui-serif, Georgia, 'Times New Roman', serif;
        color: var(--ink);
        background: var(--paper);
        line-height: 1.6;
      }
      header {
        border-bottom: 1px solid var(--line);
        background: #fff;
      }
      nav {
        max-width: var(--max);
        margin: 0 auto;
        padding: 1rem 1.25rem;
        display: flex;
        gap: 1.5rem;
        align-items: baseline;
        font-family: ui-sans-serif, system-ui, sans-serif;
      }
      nav .brand { font-weight: 700; color: var(--leaf-dark); margin-right: auto; }
      nav a { color: var(--leaf); text-decoration: none; }
      nav a:hover { text-decoration: underline; }
      main { max-width: var(--max); margin: 0 auto; padding: 2.5rem 1.25rem; }
      h1, h2, h3 { font-family: ui-sans-serif, system-ui, sans-serif; color: var(--leaf-dark); line-height: 1.25; }
      h1 { font-size: 2rem; margin-top: 0; }
      a { color: var(--leaf); }
      table { border-collapse: collapse; width: 100%; margin: 1.5rem 0; font-size: 0.95rem; }
      th, td { border: 1px solid var(--line); padding: 0.5rem 0.65rem; text-align: left; vertical-align: top; }
      th { background: #eef0e6; font-family: ui-sans-serif, system-ui, sans-serif; }
      blockquote {
        border-left: 4px solid var(--leaf);
        margin: 1.5rem 0;
        padding: 0.5rem 1rem;
        background: #eef0e6;
        font-style: italic;
      }
      footer {
        border-top: 1px solid var(--line);
        margin-top: 3rem;
        padding: 1.5rem 1.25rem;
        text-align: center;
        font-family: ui-sans-serif, system-ui, sans-serif;
        font-size: 0.85rem;
        color: #6b6f63;
      }
    </style>
  </body>
</html>
